@startuml
skinparam backgroundStyle white
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontSize 12
skinparam roundCorner 0
title DFD Level 1 — Rincian Proses 1.0 "Menyajikan Situs Resmi RSUD"

left to right direction

rectangle "Pengunjung" as E1
rectangle "Admin Konten\n(Provinsi)" as E2

circle "1.1\nMenyajikan Halaman\n(ISR / SSR / client)" as P11
circle "1.2\nMemanggil Sumber Data\nEksternal (proxy server)" as P12
circle "1.3\nMenyajikan Layanan\nInteraktif" as P13
circle "1.4\nMenyajikan Dokumen\nPPID & Unduhan" as P14

storage "DS1\nCache in-memory\n(ISR + __ppidCache)" as D1
storage "DS2\nmaster_data.json\n(44 kode poli)" as D2
storage "DS3\nIndeks pencarian\n+ sinonim gejala" as D3
storage "DS4\nPreferensi pengguna\n(localStorage)" as D4

rectangle "Backend Konten\napi-web.provcontoh" as X1
rectangle "Portal PPID" as X2
rectangle "BPJS Kesehatan" as X3
rectangle "SURVEI KEPUASAN + Gemini" as X4

E1 --> P11 : URL halaman / kata kunci pencarian
P11 --> E1 : HTML ter-render + aset statis

P11 --> P12 : kebutuhan data server-side
P12 --> P11 : data ternormalisasi
E2 --> P12 : konten baru diterbitkan

P12 --> X1 : GET /api/proxy/... (s-maxage 60)
X1 --> P12 : JSON mentah
P12 --> D1 : tulis/baca entri segar
P12 --> D2 : baca daftar poli
P12 --> X3 : jadwal poli (HMAC + AES)
X3 --> P12 : respons terenkripsi

P11 --> P13 : permintaan interaktif
P13 --> E1 : hasil pencarian, jawaban chat, skor IKM
P13 --> D3 : cocokkan kata kunci + sinonim
P13 --> D4 : baca locale & setelan aksesibilitas
P13 --> X4 : /api/SURVEI KEPUASAN + /api/chat

P11 --> P14 : klik unduh dokumen
P14 --> X2 : GET stream (redirect maks 5)
X2 --> P14 : berkas biner
P14 --> E1 : berkas + Cache-Control private
P14 --> D1 : gunakan daftar dokumen cache

@enduml
